{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baaki",
  "version": "1.2.0",
  "identifier": "com.jeet.baaki",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node sync-dist.mjs",
    "beforeDevCommand": "node sync-dist.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A deadline countdown.",
    "longDescription": "A deadline countdown that floats above your work and starts with your machine. The goal lives in the link, so sharing the link shares the countdown."
  }
}